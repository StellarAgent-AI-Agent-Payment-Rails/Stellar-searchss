{
  "$schema": "https://openapi.vercel.com/v1/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(:path*)",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!.*\\..).*)",
      "destination": "/index.html"
    }
  ]
}
