{
  "name": "stellar-search",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && vite build",
    "analyze": "ANALYZE=1 tsc && ANALYZE=1 vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "mcp": "tsx mcp-server/index.ts",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "test:search": "tsx scripts/test-search.ts",
    "test:suggestions": "tsx scripts/test-search.ts \"Stellar blockchain\" --count 3",
    "test:serper-schema": "tsx scripts/check-serper-schema.ts",
    "test:parity": "tsx tests/parity.test.ts",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && vercel --prod",
    "load-test": "node scripts/load-test.js",
    "test:url": "node --import tsx --test server/urlSummary.test.ts",
    "typecheck": "tsc --noEmit",
    "test:a11y": "vitest run src/a11y.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --project=dev",
    "test:e2e:preview": "playwright test --project=preview",
    "test:e2e:ui": "playwright test --ui",
    "mcp:http": "tsx mcp-server/index.ts --transport http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@stellar/freighter-api": "^3.1.0",
    "@stellar/stellar-sdk": "^14.0.0",
    "@vercel/node": "^5.7.4",
    "@x402/core": "^2.9.0",
    "@x402/express": "^2.9.0",
    "@x402/fetch": "^2.9.0",
    "@x402/stellar": "^2.9.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "framer-motion": "^11.0.0",
    "groq-sdk": "^0.9.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "jsdom": "^26.0.0",
    "msw": "^2.15.0",
    "postcss": "^8.4.35",
    "rollup-plugin-visualizer": "^5.4.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^2.1.9",
    "vitest-axe": "^0.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bash -c 'tsc --noEmit'",
      "eslint --fix"
    ]
  }
}
