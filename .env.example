# ════════════════════════════════════════════════════
#  StellarSearch — Environment Variables
#  Copy to .env and fill in your real values
# ════════════════════════════════════════════════════

# ─── Stellar: server receiving wallet ────────────────
# This address receives 0.001 USDC for every search
# Generate at: https://laboratory.stellar.org/#account-creator?network=test
STELLAR_RECEIVING_ADDRESS=GBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Stellar network ─────────────────────────────────
# stellar:testnet  → development (free testnet USDC)
# stellar:mainnet  → production  (real USDC)
STELLAR_NETWORK=stellar:testnet
VITE_STELLAR_NETWORK=stellar:testnet

# ─── x402 Facilitator ────────────────────────────────────
# Uses the official x402 facilitator at x402.org (no API key needed for testnet)
# Docs: https://developers.stellar.org/docs/build/agentic-payments/x402/built-on-stellar
FACILITATOR_URL=https://www.x402.org/facilitator

# ─── Serper.dev Search API ──────────────────────────────
# Google search results via Serper.dev (free tier: 2,500 queries/month)  
# Sign up at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# ─── Groq AI ─────────────────────────────────────────
# Powers the floating AI assistant (Llama 3.3 70B)
# Free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Server ──────────────────────────────────────────
PORT=3001

# ─── Rate limiting ────────────────────────────────────
# Per-IP limits are applied to every endpoint. Free endpoints are capped
# tighter than the paid x402 routes, since they cost money per call.
# Set RATE_LIMIT_ENABLED=false to disable (not recommended in production).

# Global catch-all for any route without a dedicated limit.
#   RATE_LIMIT_GLOBAL_MAX=300

# Paid routes — x402 already gates these behind a payment, so limits are loose.
#   RATE_LIMIT_SEARCH_MAX=60
#   RATE_LIMIT_IMAGES_MAX=60
#   RATE_LIMIT_NEWS_MAX=60

# Free endpoints — stricter.
#   RATE_LIMIT_AI_CHAT_MAX=20
#   RATE_LIMIT_HEALTH_MAX=30

# Extra fixed-window cap for POST /summarize-url, which triggers an outbound
# fetch and has no dedicated scope above. Shares RATE_LIMIT_WINDOW_MS.
#   SUMMARIZE_URL_RATE_LIMIT_MAX=30

# Length of the sliding window, in milliseconds (default: 60000).
RATE_LIMIT_WINDOW_MS=60000

# Number of proxy hops in front of the app, used to read the real client IP
# from X-Forwarded-For. Vercel sits one hop in front, hence the default of 1.
# Accepts a hop count or a comma-separated subnet allowlist — never `true`,
# which would let clients spoof their IP and bypass the limits.
TRUST_PROXY=1

# Comma-separated browser origins allowed when NODE_ENV=production.
# Development always uses * regardless of this value.
# Example: http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ─── Frontend (Vite env vars) ────────────────────────
# Used by the React frontend to reach the server
VITE_SERVER_URL=http://localhost:3001

# ─── Stats store (optional) ──────────────────────────
# External counter store for serverless deployments.
# Without this, /health omits counters instead of reporting
# cold-start zeros. Locally, an in-memory fallback is used.
# Upstash Redis REST credentials (Vercel KV compatible):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── MCP server ──────────────────────────────────────
SEARCH_API_URL=http://localhost:3001

# ─── Paid e2e test only (scripts/test-search.ts -- --paid) ──
# Testnet payer key. The paid test SPENDS TESTNET USDC (~0.001 USDC/search).
# Fund with XLM + a USDC trustline + testnet USDC before use. Never use a
# mainnet key here.
# STELLAR_PAYER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
