# ════════════════════════════════════════════════════
#  StellarSearch — Production Environment Variables
# ════════════════════════════════════════════════════

# ─── Stellar: server receiving wallet ────────────────
STELLAR_RECEIVING_ADDRESS=GBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Stellar network ─────────────────────────────────
STELLAR_NETWORK=stellar:testnet
VITE_STELLAR_NETWORK=stellar:testnet

# ─── x402 Facilitator ────────────────────────────────────
FACILITATOR_URL=https://www.x402.org/facilitator

# ─── Serper.dev Search API ──────────────────────────────
SERPER_API_KEY=your_serper_api_key_here

# ─── Groq AI ─────────────────────────────────────────
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Server ──────────────────────────────────────────
PORT=3000

# ─── Frontend (Vite env vars) ────────────────────────
VITE_SERVER_URL=/api

# ─── MCP server (optional — not read by the Vercel functions) ──
# Absolute base URL of *your* deployed API, including the /api prefix that
# vercel.json routes. The MCP server appends /search, /images, /news,
# /summarize-url and /health to it. Default when unset: http://localhost:3001
# Canonical hosted example: https://stellar-search-2twg.vercel.app/api
SEARCH_API_URL=https://your-app.vercel.app/api
